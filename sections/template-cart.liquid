{% if cart.item_count > 0 %}
  <div class="p-4">
    <div class="max-w-6xl flex flex-col my-10 mx-auto">
      <div class="flex justify-between my-5">
        <h1 class="text-xl  font-medium">Your cart</h1>
        <a class="text-blue-500 underline" href="{{ routes.all_products_collection_url }}">Continue Shopping</a>
      </div>
    </div>

    <div class="max-w-6xl flex flex-col my-10 mx-auto">
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        <table class="table-auto divide-y divide-gray-200 my-4 w-full">
          <thead>
            <th class="px-6 py-3 text-left text-sm">Product</th>
            <th class="px-6 py-3 text-left text-sm">Quantity</th>
            <th class="px-6 py-3 text-left text-sm">Total Price</th>
          </thead>
          <tbody>
            {% for item in cart.items %}
              <tr class="table-row">
                <td class="py-4 px-2 flex flex-col justify-center">
                  <a href="{{ item.url }}">
                    {% if item.image %}
                      <img
                        class="w-20 h-20 object-cover border"
                        src="{{ item.image | image_url: width: 80 }}"
                        alt="{{ item.image.alt }}"
                      >
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'w-20 h-20 object-cover border' }}
                    {% endif %}
                  </a>
                </td>
                <td class="py-4 px-2 flex flex-col justify-center">
                  <a href="{{ item.url }}">{{ item.product.title | truncatewords: 10 }}</a>
                  <span>-{{ item.variant.title }}</span>
                  <a
                    class="text-red-500 font-semibold"
                    href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0"
                    >remove</a
                  >
                </td>
                <td class="py-4 px-2">
                  <input
                    class="w-20 border p-2"
                    type="number"
                    name="updates[]"
                    value="{{ item.quantity }}"
                    min="1"
                    id="updates_{{ forloop.index }}"
                  >
                </td>
                <td class="py-4 px-2">
                  {{ item.line_price | money }}
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="flex flex-row md:flex-row items-center justify-between">
          <div class="w-full my-4">
            <div class="flex flex-col items-start">
              <label for="cart_notes">Cart Notes</label>
              <textarea class="w-full md:max-w-lg resize-none border h-20" name="" id="cart_notes"></textarea>
            </div>
          </div>
          <div class="w-full my-4 md:w-80">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'subtotal' %}
                  <h3 class="text-xl">Subtotal: {{ cart.total_price | money }}</h3>
                {% when 'update_button' %}
                  <div class="my-2">
                    <button
                      type="submit"
                      name="update"
                      class="w-full p-3 border border-gray-600 text-gray-600 font-medium hover:bg-gray-600 hover:text-white"
                    >
                      Update
                    </button>
                  </div>
                {% when 'checkout_button' %}
                  <div class="my-2">
                    <button
                      type="submit"
                      name="checkout"
                      class="w-full p-3 border   font-medium bg-gray-600 text-white"
                    >
                      Checkout
                    </button>
                  </div>
                {% else %}

              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </form>
    </div>
  </div>
{% else %}
  <div class="flex flex-col items-center my-16 gap-8">
    <h1 class="text-2xl text-red-500">Your cart is empty</h1>
    <div>
      <a class="bg-gray-900 px-4 py-2 text-white" href="{{ routes.all_products_collection_url }}"
        >Go back to shopping</a
      >
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Template Cart",
  "blocks": [
    {
      "type": "subtotal",
      "name": "subtotal",
      "limit": 1
    },
    {
      "type": "update_button",
      "name": "update_button",
      "limit": 1
    },
    {
      "type": "checkout_button",
      "name": "checkout_button",
      "limit": 1
    }
  ]
}
{% endschema %}
