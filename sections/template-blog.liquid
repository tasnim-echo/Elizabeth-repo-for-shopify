{% paginate blog.articles by section.settings.number_of_blog_posts %}
  <h1 class="text-center text-3xl mb-5">{{ blog.title }}</h1>
  <div class="max-w-6xl mx-auto">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {% for article in blog.articles %}
        <div class="shadow-lg p-5 rounded-lg">
          <a href="{{ article.url }}">
            {% if article.image %}
              <img
                class="w-full h-80 object-cover rounded-lg"
                src="{{ article.image | image_url: width: 600 }}"
                alt="{{ article.image.alt }}"
              >

            {% else %}
              {{ 'image' | placeholder_svg_tag: 'w-full h-80 object-cover bg-gray-600 rounded-lg' }}
            {% endif %}
          </a>

          <h1 class="mt-3 mb-2 text-center text-xl font-semibold">{{ article.title }}</h1>
          {% if article.excerpt.size > 0 %}
            {{ article.excerpt }}
          {% else %}
            {{ article.content | strip_html | truncatewords: 20 }}
          {% endif %}

          <a class="text-blue-800 underline" href="{{ article.url }}">{{ section.settings.blog_read_more }}</a>
        </div>
      {% endfor %}
    </div>
  </div>

  <div class="max-w-6xl mx-auto">
    {% render 'pagination', pagination: paginate %}
  </div>
{% endpaginate %}
{% schema %}
{
  "name": "Blog",
  "settings": [
    {
      "type": "range",
      "id": "number_of_blog_posts",
      "step": 1,
      "min": 1,
      "max": 6,
      "label": "Number of blogs per page",
      "default": 3
    },
    {
      "type": "text",
      "id": "blog_read_more",
      "label": "Inside text",
      "default": "Read More"
    }
  ]
}
{% endschema %}
