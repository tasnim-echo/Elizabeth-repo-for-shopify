<div class="bg-gray-50 py-16">
  <div class="max-w-2xl mx-auto px-6">
    {% if section.settings['form-title'] != blank %}
      <div class="text-center mb-10">
        <h2 class="text-4xl font-bold text-gray-900">
          {{ section.settings['form-title'] }}
        </h2>
      </div>
    {% endif %}

    <div class="bg-white rounded-2xl shadow-lg p-8">
      {% form 'contact', novalidate: 'novalidate' %}
        {% if form.errors %}
          <div class="mb-6 rounded-lg border border-red-300 bg-red-50 p-4">
            <div class="flex items-center gap-2 mb-2">
              {% render 'icon-error' %}
              <p class="font-semibold text-red-700">Please fix the following errors:</p>
            </div>

            <ul class="list-disc list-inside text-red-700">
              {% for error in form.errors %}
                <li>{{ form.errors.messages[error] }}</li>
              {% endfor %}
            </ul>
          </div>
        {% elsif form.posted_successfully? %}
          <div class="mb-6 rounded-lg border border-green-300 bg-green-50 p-4">
            <div class="flex items-center gap-2">
              {% render 'icon-success' %}
              <p class="font-semibold text-green-700">Your message has been submitted successfully!</p>
            </div>
          </div>
        {% endif %}

        <div class="space-y-5">
          <div>
            <label
              for="contact_name"
              class="block mb-2 text-sm font-medium text-gray-700"
            >
              Name
            </label>

            <input
              type="text"
              name="contact[name]"
              id="contact_name"
              placeholder="John Doe"
              class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none transition"
            >
          </div>

          <div>
            <label
              for="contact_email"
              class="block mb-2 text-sm font-medium text-gray-700"
            >
              Email
            </label>

            <input
              type="email"
              name="contact[email]"
              id="contact_email"
              placeholder="john@example.com"
              class="w-full rounded-lg border border-gray-300 px-4 py-3 focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none transition"
            >
          </div>

          <div>
            <label
              for="contact_message"
              class="block mb-2 text-sm font-medium text-gray-700"
            >
              Message
            </label>

            <textarea
              name="contact[body]"
              id="contact_message"
              rows="6"
              placeholder="Write your message..."
              class="w-full rounded-lg border border-gray-300 px-4 py-3 resize-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500 outline-none transition"
            ></textarea>
          </div>

          <button
            type="submit"
            class="w-full rounded-lg bg-black text-white py-3 font-semibold hover:bg-gray-800 transition duration-300"
          >
            Send Message
          </button>
        </div>
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact Form",
  "settings": [
    {
      "type": "text",
      "id": "form-title",
      "label": "Form Title",
      "default": "Contact Us"
    }
  ],
  "presets": [
    {
      "name": "Contact Form"
    }
  ]
}
{% endschema %}
