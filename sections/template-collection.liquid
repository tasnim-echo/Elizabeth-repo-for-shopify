<div class="px-4 py-16">
  {% paginate collection.products by section.settings.products_per_page %}
    <h1 class="text-3xl font-bold text-center mb-8">{{ collection.title }}</h1>

    <div class="max-w-6xl mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {% for product in collection.products %}
          {% render 'product-card', product: product, show_vendor: section.settings.show_vendor %}
        {% else %}
          <p class="col-span-full text-center">There are no available products</p>
        {% endfor %}
      </div>
    </div>

    {% render 'pagination', pagination: paginate %}
  {% endpaginate %}
</div>

{% schema %}
{
  "name": "Template Collection",
  "settings": [
    {
      "type": "number",
      "id": "products_per_page",
      "default": 6,
      "label": "Products per page"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show vendor",
      "default": true
    }
  ]
}
{% endschema %}
