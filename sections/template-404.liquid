<div class="text-center max-w-md">
  <!-- Title -->
  <h2 class="text-2xl font-semibold text-gray-800 mb-2">
    {{ section.settings.title }}
  </h2>

  <!-- Subtext -->
  <p class="text-gray-500 mb-6">
    {{ section.settings.subtext }}
  </p>

  <!-- Button -->
  <div>
    {% if section.settings.button_link == blank %}
      {% assign url = shop.secure_url %}
    {% else %}
      {% assign url = section.settings.button_link %}
    {% endif %}
    <a href="{{ url }}" class="inline-block px-6 py-3 bg-black text-white rounded-lg hover:bg-gray-800 transition">
      {{ section.settings.button_text }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "Template 404",
  "tag": "section",
  "class": "flex items-center justify-center h-screen",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Page not found"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "The page you are looking for doesn't exist."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Go Back Home"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ]
}
{% endschema %}
